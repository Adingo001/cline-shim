# Debug probes and one-off analysis scripts.
#
# These were used to measure the upstream while building the shim. Most of them
# carry a live gateway token in plaintext, so they stay local and out of the
# published tree.
tests/_probe*.py
tests/_probe*.sh
tests/_ctx_*.py
tests/_e2e.py
tests/_smoke.py
tests/_stream_smoke.py
tests/_models.sh

# Session notes -- working documents, not documentation.
SESSION-*.md

# Superseded by install-autostart.ps1, which installs both layers at once.
tests/_install_service.py

# The OpenAI4S-side launcher and its patches. Kept on disk for the other
# install that still uses them, deliberately out of this repository.
_legacy/

# Runtime artifacts.
*.log
# The supervisor records the shim's stdout and stderr side by side, and rotates
# them with a timestamp suffix -- neither name ends in .log, so *.log misses them
# and they landed in a commit before this rule existed.
*.log.*
*.pid
__pycache__/
*.pyc

# Editorial backups.
*.bak

# Shim stdout captured while testing CLINE_SHIM_BIND; the analyzer's name, not a keeper.
_bt.err
*.err
